# Configuración del Proveedor LLM para Microsoft Agent Framework

# Opción 1: Azure AI Foundry (Recomendado)
AI_FOUNDRY_API_KEY=xxxxx
AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
AI_FOUNDRY_MODEL=gpt-4o-mini

# Opción 2: Azure OpenAI Service
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Opción 3: OpenAI Directo
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Puerto para DevUI (por defecto 8090)
DEVUI_PORT=8090
